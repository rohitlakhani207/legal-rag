# Copy to .env and adjust. Every value has a working default; nothing here costs money.

# --- Local development (backend run from your shell) -----------------------------
# PostgreSQL + pgvector (docker compose exposes it on 5433 to avoid clashing with a local Postgres)
DATABASE_URL=postgresql://legalrag:legalrag@localhost:5433/legalrag
OLLAMA_BASE_URL=http://localhost:11434

# --- Models (all open source, all local) -------------------------------------------
# Generator. Small models are practical on CPU; try llama3.2:3b, gemma3:4b or qwen3:8b too.
OLLAMA_MODEL=qwen3.5:4b
# Faithfulness judge. Empty = same as OLLAMA_MODEL. A larger judge (e.g. gemma4:12b) is less biased.
JUDGE_MODEL=
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-12-v2

# --- Retrieval ---------------------------------------------------------------------
TOP_K=5
CANDIDATES_PER_RETRIEVER=50
RERANK_CANDIDATES=30
RRF_K=60
# Full-text search drops query terms found in more than this share of chunks (Postgres FTS has no IDF).
FTS_MAX_DF=0.2

# --- Docker compose ports ------------------------------------------------------------
DB_PORT=5433
API_PORT=8000
WEB_PORT=8080
